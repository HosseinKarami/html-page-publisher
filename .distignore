# Files and directories to exclude from the WordPress.org distribution zip.
# Used by tools like `wp-dist-archive` (10up) and most WP deploy scripts.
# Everything listed here stays in the git repo but is NOT shipped to users.

.git
.github
.gitignore
.gitattributes
.distignore
.DS_Store
